name: Build Ling-3.0-tiny Server for RTX 50 Series (Windows Native)

on:
  workflow_dispatch:
    inputs:
      tag_name:
        description: 'Release 版本号（如 v1.0.0）'
        required: true
        default: 'v1.0.0'
        type: string

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  GH_TOKEN: ${{ github.token }}

jobs:
  build:
    runs-on: windows-2022
    permissions:
      actions: write
      contents: write

    steps:
      # 1. 物理屏蔽预装MinGW（核心修复：无需卸载权限，直接重命名目录）
      - name: Disable Preinstalled MinGW
        shell: cmd
        run: |
          echo === 物理屏蔽预装MinGW（重命名目录，彻底消灭cc.exe）===
          if exist "C:\mingw64" (
            ren "C:\mingw64" "C:\mingw64_bak"
            echo MinGW目录已重命名为 C:\mingw64_bak
          ) else (
            echo MinGW目录不存在，无需处理
          )
          echo === 验证MinGW是否已清除 ===
          where cc.exe && (echo ❌ 错误：cc.exe仍存在！ && exit /b 1) || echo ✅ cc.exe已彻底消失
          where gcc.exe && (echo ❌ 错误：gcc.exe仍存在！ && exit /b 1) || echo ✅ gcc.exe已彻底消失

      # 2. 拉取aetherbird官方bailingmoe3-support分支（完全匹配你提供的仓库链接）
      - name: Checkout aetherbird/llama.cpp (bailingmoe3-support)
        uses: actions/checkout@v4
        with:
          repository: aetherbird/llama.cpp
          ref: bailingmoe3-support
          submodules: recursive

      # 3. 加载MSVC环境（官方Action，100%解决路径问题，环境变量自动继承到后续步骤）
      - name: Setup MSVC Environment
        uses: ilammy/msvc-dev-cmd@v1
        with:
          arch: x64

      # 4. 安装稳定版CMake（规避CMake 4.4的新编译器检测bug）
      - name: Setup CMake 3.28.1
        uses: lukka/get-cmake@v3.28.1

      # 5. 安装编译依赖
      - name: Install Dependencies
        shell: cmd
        run: |
          echo === 安装OpenSSL和Ninja ===
          choco install openssl ninja -y --no-progress
          where ninja || (echo ❌ ninja未安装 && exit /b 1)
          where cl.exe || (echo ❌ MSVC cl.exe未加载 && exit /b 1)
          nvcc --version || (echo ❌ nvcc未找到 && exit /b 1)
          echo === 验证PATH无MinGW残留 ===
          echo %PATH% | findstr /i mingw && (echo ❌ PATH中仍有MinGW残留！ && exit /b 1) || echo ✅ PATH无MinGW残留

      # 6. CMake配置（强制使用MSVC，彻底屏蔽MinGW干扰）
      - name: Configure CMake
        shell: cmd
        run: |
          echo === 清理旧构建缓存 ===
          if exist build rmdir /s /q build
          mkdir build
          echo === 开始CMake配置 ===
          cmake -S . -B build -G "Ninja Multi-Config" ^
            -DCMAKE_C_COMPILER=cl.exe ^
            -DCMAKE_CXX_COMPILER=cl.exe ^
            -DCMAKE_C_COMPILER_WORKS=ON ^          # 强制跳过C编译器检测，避免/MT参数报错
            -DCMAKE_CXX_COMPILER_WORKS=ON ^        # 强制跳过C++编译器检测
            -DCMAKE_IGNORE_PATH="C:/mingw64_bak/bin" ^ # 强制忽略重命名后的MinGW路径
            -DGGML_CUDA=ON ^                        # 启用CUDA后端（llama.cpp官方标准开关）
            -DCMAKE_CUDA_ARCHITECTURES="120" ^      # RTX 50系Blackwell架构专属算力
            -DGGML_CUDA_FA_ALL_QUANTS=ON ^          # 编译Flash Attention量化内核（MoE模型必需）
            -DGGML_NATIVE=OFF ^                     # 关闭CPU原生优化，保证二进制通用性
            -DLLAMA_BUILD_SERVER=ON ^               # 仅构建llama-server目标
            -DLLAMA_BUILD_BORINGSSL=OFF ^           # 禁用BoringSSL，使用系统OpenSSL
            -DOPENSSL_USE_STATIC_LIBS=ON ^          # 静态链接OpenSSL，避免运行时依赖
            -DOPENSSL_ROOT_DIR="C:\Program Files\OpenSSL-Win64" ^
            -DCMAKE_C_FLAGS="/MT" ^                 # 静态链接VC运行库
            -DCMAKE_CXX_FLAGS="/MT" ^
            -DCMAKE_VERBOSE_MAKEFILE=ON             # 输出详细编译日志，方便排查问题
          if %ERRORLEVEL% neq 0 (echo ❌ CMake配置失败 && exit /b 1)
          echo ✅ CMake配置完成，已强制使用MSVC编译器

      # 7. 编译llama-server
      - name: Build llama-server
        shell: cmd
        run: |
          echo === 开始编译llama-server ===
          set /A NINJA_JOBS=%NUMBER_OF_PROCESSORS%-1
          cmake --build build --config Release -j %NINJA_JOBS% -t llama-server
          if %ERRORLEVEL% neq 0 (echo ❌ 编译失败 && exit /b 1)
          echo 🎉🎉🎉 编译成功！

      # 8. 收集运行产物
      - name: Collect Artifacts
        shell: cmd
        run: |
          echo === 收集编译产物 ===
          mkdir out
          copy build\bin\Release\llama-server.exe out\
          copy build\bin\Release\ggml*.dll out\
          copy build\bin\Release\llama*.dll out\
          copy build\bin\Release\mtmd.dll out\
          copy "%CUDA_PATH%\bin\cudart64_*.dll" out\
          copy "%CUDA_PATH%\bin\cublas64_*.dll" out\
          copy "%CUDA_PATH%\bin\cublasLt64_*.dll" out\
          copy "C:\Windows\System32\vcruntime140.dll" out\
          copy "C:\Windows\System32\vcruntime140_1.dll" out\
          copy "C:\Windows\System32\msvcp140.dll" out\
          copy "C:\Windows\System32\msvcp140_1.dll" out\
          copy "C:\Windows\System32\msvcp140_2.dll" out\
          copy "C:\Windows\System32\concrt140.dll" out\
          echo === 最终产物列表 ===
          dir out\

      # 9. 创建GitHub Release并上传产物
      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ inputs.tag_name }}
          name: Ling-3.0-tiny Server ${{ inputs.tag_name }} — Windows Native RTX 50 Series
          body: |
            ## 🐦 Ling-3.0-tiny Windows 原生版（RTX 50 Series / Blackwell sm_120）
            基于[aetherbird/llama.cpp](https://github.com/aetherbird/llama.cpp/tree/bailingmoe3-support)的`bailingmoe3-support`分支编译，原生支持Ling-3.0-tiny的`bailingmoe3`架构。

            ### ✨ 核心特性
            - **CUDA 12.8 + sm_120**：Blackwell架构原生编译，适配全RTX 50系桌面显卡（5050/5060/5060Ti/5070/5080/5090）
            - **Windows原生运行**：无需WSL，直接调用显卡驱动，性能与Linux持平
            - **开箱即用**：静态链接OpenSSL+VC++运行库，内置CUDA 12.8运行库，无需额外安装依赖
            - **MoE模型优化**：启用Flash Attention全量化内核，大幅提升Ling-3.0-tiny推理效率

            ### 💻 显存适配参考
            | 显存 | 适用显卡 | 推荐模型规模 |
            |---|---|---|
            | 8GB | RTX 5050/5060 | 7B-14B量化模型 |
            | 16GB | RTX 5060Ti/5070/5080 | 14B-32B量化模型 |
            | 32GB | RTX 5090 | 70B以内量化模型 |

